# ══════════════════════════════════════════════════════════════
# Akademee — Variables d'environnement (Backend)
# Copier ce fichier en .env et remplir les valeurs
# ══════════════════════════════════════════════════════════════

# ── Base de données ──
DATABASE_URL=postgresql://user:password@localhost:5432/akademee
DATABASE_SSL=false

# ── Authentification ──
JWT_SECRET=__________________________________
JWT_EXPIRES_IN=7d

# ── Serveur ──
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ── Fapshi Payment Gateway ──
# Mode: 'sandbox' ou 'live'
FAPSHI_ENV=sandbox

# Identifiants API (trouvable dans le dashboard Fapshi)
FAPSHI_API_USER=__________________________________
FAPSHI_API_KEY=__________________________________

# Secret webhook (doit correspondre à celui configuré dans Fapshi dashboard)
FAPSHI_WEBHOOK_SECRET=__________________________________

# ── URLs publiques ──
# FRONTEND_URL : URL publique du frontend (pour redirect Fapshi après paiement)
# APP_HOST : URL publique du backend (pour le webhook Fapshi)
#
# Architecture Akademee (un seul domaine, Nginx proxy) :
FRONTEND_URL=http://localhost:3000
APP_HOST=localhost:5000

# Production (un seul domaine akademee.com) :
# FRONTEND_URL=https://akademee.com
# APP_HOST=https://akademee.com

# ── Email (SMTP) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=noreply@akademee.com

# ── Cloudinary (uploads) ──
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ── Supabase (optionnel) ──
# SUPABASE_URL=
# SUPABASE_KEY=

# ── Sentry (monitoring) ──
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Domaines tenants ──
# TENANT_DEV_DOMAIN=lvh.me
# TENANT_PROD_DOMAIN=akademee.com
